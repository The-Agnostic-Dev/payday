APP_NAME=Payday
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5119

# Several workers so two people can use the app at the same time.
PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=480

CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
